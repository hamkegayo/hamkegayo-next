NEXT_PUBLIC_SUPABASE_URL=복사한_Project_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=복사한_anon_Key
SUPABASE_SERVICE_ROLE_KEY=복사한_service_role_Key

# 이메일 발송(Resend): RESEND_API_KEY 미설정 시 개발용 Mock(콘솔 출력)으로 동작
# EMAIL_FROM 미설정 시 기본 발신주소(함께가요 <no-reply@hamkegayo.kr>)로 발송
# ※ 발신 도메인(hamkegayo.kr)은 Resend에서 인증 완료된 상태여야 실제 발송됨
RESEND_API_KEY=복사한_Resend_API_Key
EMAIL_FROM=함께가요 <no-reply@hamkegayo.kr>

# Vercel Cron 인증용 시크릿(Supabase 미사용 일시정지 방지 keepalive).
# Vercel 에 같은 이름으로 등록하면 Cron 요청에 Authorization 헤더가 자동 첨부된다.
# 미설정 시 /api/cron/keepalive 는 500 으로 요청을 거부한다.
# 값 생성: openssl rand -base64 32
CRON_SECRET=임의의_난수_문자열

# 공공데이터포털 「특일 정보」 API 인증키 — 주말·공휴일 30% 할증 판정(약관 제13조 ①).
# 발급: https://www.data.go.kr → 특일 정보 → 활용신청. Encoding 된 일반 인증키를 그대로 넣는다.
# 미설정/호출 실패 시 lib/holidays.ts 의 폴백 테이블을 쓰며, 토·일 할증은 키 없이도 동작한다.
DATA_GO_KR_SERVICE_KEY=발급받은_일반_인증키_Encoding

# 애널리틱스(GA4 / Meta Pixel): 값이 없으면 로드하지 않음.
# 기본은 프로덕션에서 + 사용자 동의(쿠키 배너) 시에만 로드된다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
# 로컬/미러링에서 DebugView·Pixel Helper 로 검증할 때만 true (기본 미설정=off)
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# NICEPAY 결제 연동(신형 API, api.nicepay.co.kr/v1) — 선결제·추가결제·취소 승인용.
#  · CLIENT_KEY 는 브라우저가 결제창을 띄울 때 쓰므로 NEXT_PUBLIC_ 이 붙는다(노출 전제).
#  · SECRET_KEY 는 승인 API 인증용이다. ⚠️ 절대 NEXT_PUBLIC_ 을 붙이지 말 것 —
#    붙이는 순간 클라이언트 번들에 박혀 누구나 결제를 승인·취소할 수 있게 된다.
#  · 실제 값은 .env.local 에만 넣는다. 이 파일에는 이름만 남긴다.
NEXT_PUBLIC_NICEPAY_CLIENT_KEY=발급받은_Nicepay_Client_Key
NICEPAY_SECRET_KEY=발급받은_Nicepay_Secret_Key

# 결제 링크·안내 메일에 넣을 절대 주소. 메일에는 상대경로를 못 쓴다.
#  · 미설정 시 https://www.hamkegayo.kr 로 폴백한다(운영 기본값).
#  · 프리뷰/스테이징에서는 그 배포 주소를 넣어야 링크가 제 환경으로 돌아온다.
NEXT_PUBLIC_SITE_URL=https://www.hamkegayo.kr

# 결제 사고 알림 수신자 — 승인 취소 실패·타임아웃 등 돈이 어긋난 상황을 즉시 알린다.
#  · 미설정 시 payment_incidents 에 적재만 하고 메일은 보내지 않는다(동작은 정상).
#  · 발송은 Resend 를 쓰므로 RESEND_API_KEY 가 없으면 콘솔 Mock 으로만 출력된다.
#  · 여러 명이면 담당자 그룹 주소를 쓴다.
PAYMENT_ALERT_EMAIL=담당자_이메일주소